<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F5F5F5">

    <!-- 连接状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="蓝牙: ○ 未连接"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvBatteryInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电量: --"
                android:textSize="14sp"
                android:textColor="#666666" />
        </LinearLayout>

        <!-- BT经典蓝牙/A2DP 状态 -->
        <TextView
            android:id="@+id/tvBtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="音频: ○ 未配对"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 连接控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnScanDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="扫描设备"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="断开连接"
            android:enabled="false"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- BT音频配对按钮 -->
    <Button
        android:id="@+id/btnBtPair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="连接音频 (BT配对)"
        android:enabled="false"
        android:textSize="14sp" />

    <!-- 媒体控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="拍照"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="开始录音"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 同步按钮 -->
    <Button
        android:id="@+id/btnSyncMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="同步媒体文件"
        android:textSize="14sp" />

    <!-- 照片预览 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最新照片预览"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <ImageView
        android:id="@+id/ivPhotoPreview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#E0E0E0"
        android:scaleType="fitCenter"
        android:contentDescription="照片预览"
        android:visibility="visible" />

    <!-- 查看所有照片按钮 -->
    <Button
        android:id="@+id/btnViewAllPhotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="查看所有照片"
        android:textSize="14sp" />

    <!-- 语音文件列表 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="语音文件列表"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAudioFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
